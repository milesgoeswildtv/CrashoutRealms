webkit-line-clamp:5; -webkit-box-orient:vertical; }
.card-stats { margin-top:auto; display:flex; gap:5px; align-items:center; flex-wrap:wrap; }
.badge { border:1px solid #465264; border-radius:7px; padding:3px 5px; font-size:9px; background:#0c1117; }
.badge.hp { color:#ffa5aa; }
.badge.str { color:#ffda92; }
.badge.pressure { color:#9fdfec; }
.badge.cracked { color:#fff2ad; border-color:#887b48; }
.badge.echo { color:#c2b0e8; }
.card-cost { position:absolute; right:6px; top:6px; width:26px; height:26px; border-radius:50%; background:#090c11; border:1px solid #7c8999; display:grid; place-items:center; font-weight:900; font-size:12px; }
.card-resource { position:absolute; right:6px; bottom:6px; border-radius:8px; padding:3px 6px; background:#14271d; border:1px solid #42674f; color:#9ee0b2; font-weight:900; font-size:10px; }
.controls { border:1px solid var(--line); border-radius:16px; background:#10151c; padding:10px; display:grid; grid-template-columns:minmax(0,1fr) minmax(260px,.46fr); gap:10px; }
.action-panel { display:flex; flex-wrap:wrap; gap:7px; align-content:flex-start; }
.inspector { border-left:1px solid var(--line); padding-left:10px; min-width:0; }
.inspector h3 { margin:0 0 4px; font-size:14px; }
.inspector p { margin:4px 0; color:var(--muted); font-size:11px; line-height:1.35; }
.referee-grid { display:flex; flex-wrap:wrap; gap:5px; margin-top:8px; }
.log-panel { border:1px solid var(--line); border-radius:16px; background:#0d1218; padding:9px 10px; }
.log { max-height:170px; overflow:auto; display:flex; flex-direction:column-reverse; gap:3px; }
.log-line { font-size:11px; color:#aab5c0; border-bottom:1px solid rgba(255,255,255,.03); padding:3px 0; }
.log-line strong { color:#e7edf3; }
.modal { position:fixed; inset:0; z-index:50; background:rgba(3,5,8,.78); display:none; align-items:center; justify-content:center; padding:18px; overflow:auto; }
.modal.open { display:flex; }
.modal-card { width:min(760px,100%); max-height:calc(100vh - 36px); overflow:auto; border:1px solid #3a4656; border-radius:18px; background:linear-gradient(180deg,#171d26,#0f141b); padding:18px; box-shadow:0 22px 80px rgba(0,0,0,.55); }
.modal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:14px; }
.modal-head h2 { margin:2px 0 0; font-family:Georgia,serif; }
.setup-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
label { display:grid; gap:5px; font-size:12px; color:#bdc6d0; font-weight:800; }
select { width:100%; background:#0d1219; border:1px solid #394454; color:var(--text); border-radius:10px; padding:10px; min-height:42px; }
.duel-setup { display:grid; grid-template-columns:1fr auto 1fr; gap:12px; align-items:center; margin:15px 0; }
.setup-player { border:1px solid var(--line); border-radius:14px; padding:12px; display:grid; gap:10px; }
.setup-player h3 { margin:0; }
.versus { color:#7f8b98; font-weight:1000; }
.prototype-note { border:1px solid #3a4656; background:#0d131a; border-radius:12px; padding:10px; margin:10px 0 14px; color:#aeb9c5; font-size:12px; line-height:1.4; }
.icon-btn { width:38px; height:38px; padding:0; display:grid; place-items:center; border-radius:50%; }
.choice-list { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:8px; }
.choice-option { text-align:left; border:1px solid var(--line); background:#111720; border-radius:12px; padding:10px; cursor:pointer; }
.choice-option:hover { border-color:var(--gold); }
.modal-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:12px; }
.mulligan-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:8px; }
.mulligan-card { border:1px solid var(--line); border-radius:10px; padding:8px; background:#111720; cursor:pointer; min-height:100px; }
.mulligan-card.return { outline:2px solid var(--danger); }
.mulligan-card .mini { color:var(--muted); font-size:10px; margin-top:4px; }
.grave-list { display:grid; gap:7px; }
.grave-item { display:flex; justify-content:space-between; gap:10px; align-items:center; border:1px solid var(--line); border-radius:10px; padding:8px; }
.rules-copy { color:#b9c3cd; line-height:1.45; font-size:13px; }
.rules-copy strong { color:#fff; }
.targetable { outline:2px solid #5fae83 !important; cursor:crosshair !important; }
.targetable.enemy { outline-color:#c6636b !important; }
.toast { position:sticky; bottom:8px; margin:8px auto 0; width:max-content; max-width:90%; background:#111821; border:1px solid #3e4b5d; border-radius:999px; padding:8px 12px; font-size:11px; color:#dce3e9; }

@media (max-width: 900px) {
  .controls { grid-template-columns:1fr; }
  .inspector { border-left:0; border-top:1px solid var(--line); padding-left:0; padding-top:9px; }
  .board-grid { grid-template-columns:repeat(7,120px); }
}
@media (max-width: 620px) {
  .app-shell { padding:8px; }
  .topbar { align-items:flex-start; }
  .setup-grid, .duel-setup { grid-template-columns:1fr; }
  .versus { text-align:center; }
  .card { width:132px; min-width:132px; }
  .player-header { align-items:flex-start; }
  .realm-banner { align-items:flex-start; }
}

/* --- iPhone / touch-first PWA pass v0.2 --- */
html { -webkit-text-size-adjust: 100%; }
body {
  padding-top: env(safe-area-inset-top);
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
  padding-bottom: env(safe-area-inset-bottom);
  overscroll-behavior-y: none;
  -webkit-tap-highlight-color: transparent;
}
button, select, input, .card, .trap-chip, .choice-option, .mulligan-card {
  touch-action: manipulation;
}
.hand, .board-grid, .trap-row {
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  scroll-snap-type: x proximity;
}
.hand::-webkit-scrollbar, .board-grid::-webkit-scrollbar, .trap-row::-webkit-scrollbar { display:none; }
.card, .slot, .trap-chip { scroll-snap-align: start; }
.btn, .icon-btn { min-height: 44px; }

