tsText":"2/7","rules":"At the end of your round before Wither, choose a damaged friendly creature that is Nourished. Restore 2 HP to it.","faction":"Harvest","code":"HAR","str":2,"hp":7,"legendary":false},{"id":"HAR-025","name":"Feastroot Titan","type":"Creature","cost":7,"resource":1,"statsText":"5/9","rules":"Once per round, reduce Feastroot Titan's maximum and current HP by 2 permanently, minimum 1. Another friendly creature gains +2 STR / +2 maximum and current HP permanently.","faction":"Harvest","code":"HAR","str":5,"hp":9,"legendary":false},{"id":"HAR-026","name":"Eldergrowth, the First Orchard","type":"Legendary Creature","cost":9,"resource":2,"statsText":"6/12","rules":"On play, redistribute up to 6 permanent STR or maximum-HP bonus points among your friendly creatures. REGURGITATE - Nothing Goes to Waste: the first Regurgitate trigger each round gives +1 STR / +1 maximum and current HP permanently to two different friendly creatures instead of one, if possible. CONSUME - Feast While Warm: the first creature you Consume each round is treated as having printed Cost +2 for the Consume bonus, maximum 9.","faction":"Harvest","code":"HAR","str":6,"hp":12,"legendary":true},{"id":"HAR-027","name":"Selective Breeding","type":"Spell","cost":3,"resource":2,"statsText":"-","rules":"Choose a friendly creature with a permanent STR or maximum-HP bonus. Another friendly creature gains +1 permanent bonus of one stat type that the chosen creature has gained permanently.","faction":"Harvest","code":"HAR"},{"id":"HAR-028","name":"Cull and Compost","type":"Spell","cost":4,"resource":2,"statsText":"-","rules":"Destroy a damaged friendly creature. Draw 2 cards. Another friendly creature gains +2 maximum and current HP permanently.","faction":"Harvest","code":"HAR"},{"id":"HAR-029","name":"Late Harvest","type":"Spell","cost":6,"resource":1,"statsText":"-","rules":"Remove up to 4 permanent STR or maximum-HP bonus points from one friendly creature. Distribute the same number of permanent STR or maximum-HP bonus points among your other friendly creatures in any combination.","faction":"Harvest","code":"HAR"},{"id":"HAR-030","name":"Deep Roots","type":"Trap","cost":4,"resource":1,"statsText":"-","rules":"When a friendly creature with permanent stat bonuses would be destroyed by damage, remove up to 2 of those bonus points. Prevent 2 damage for each point removed.","faction":"Harvest","code":"HAR"}],"Continuum":[{"id":"CON-001","name":"Firststep Scout","type":"Creature","cost":1,"resource":1,"statsText":"2/3","rules":"High Sequence (4/5) - Firststep Scout has +1 STR / +1 maximum and current HP.","faction":"Continuum","code":"CON","str":2,"hp":3,"legendary":false},{"id":"CON-002","name":"Second Bell Adept","type":"Creature","cost":2,"resource":2,"statsText":"2/4","rules":"High Sequence (4/5) - The first time each round your Sequence changes while remaining at 4 or 5, Second Bell Adept gains +2 STR this round.","faction":"Continuum","code":"CON","str":2,"hp":4,"legendary":false},{"id":"CON-003","name":"Third Motion Engine","type":"Creature","cost":2,"resource":1,"statsText":"2/5","rules":"Sequence Complete - Your next card this round costs 2 less, minimum 1.","faction":"Continuum","code":"CON","str":2,"hp":5,"legendary":false},{"id":"CON-004","name":"Fourth Horizon","type":"Creature","cost":5,"resource":1,"statsText":"4/5","rules":"High Sequence (4/5) - Fourth Horizon has +2 STR / +2 maximum and current HP.","faction":"Continuum","code":"CON","str":4,"hp":5,"legendary":false},{"id":"CON-005","name":"Zero Point Witness","type":"Creature","cost":2,"resource":2,"statsText":"2/4","rules":"Sequence Complete - Restore 2 Health to yourself and 2 HP to Zero Point Witness.","faction":"Continuum","code":"CON","str":2,"hp":4,"legendary":false},{"id":"CON-006","name":"Interval Keeper","type":"Creature","cost":3,"resource":2,"statsText":"3/5","rules":"High Sequence (4/5) - The first time each round your Sequence changes, draw 1 card, then put 1 card from your 