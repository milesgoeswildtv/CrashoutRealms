":2,"statsText":"-","rules":"Move up to 2 Pressure, one at a time, from one friendly Geode to another. Pressure gained this way triggers Pressure abilities normally.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-017","name":"Shatterproof","type":"Spell","cost":2,"resource":2,"statsText":"-","rules":"Choose a friendly Geode. Until end of round, the first time damage would destroy it, resolve its Pressure gain and any Crack first. If it would still be destroyed afterward, remove 2 damage from it.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-018","name":"Sudden Bloom","type":"Spell","cost":6,"resource":1,"statsText":"-","rules":"Choose a friendly Dormant Geode. Deal 1 damage to it repeatedly, one damage event at a time, until it Cracks or is destroyed. If it Cracks, it gains +2 STR this round and may immediately act if it has not acted this round.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-019","name":"Hairline Fracture","type":"Trap","cost":3,"resource":1,"statsText":"-","rules":"When an enemy creature attacks a friendly Dormant Geode, deal 1 damage to the defender before combat damage. If it Cracks, it gains +2 STR for that combat.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-020","name":"Core Eruption","type":"Trap","cost":5,"resource":1,"statsText":"-","rules":"When a friendly Dormant Geode would be destroyed by damage, resolve its Pressure gain first. If that damage causes it to Crack and it would still be destroyed, remove 3 damage from it.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-021","name":"Seed of the Deep","type":"Creature","cost":2,"resource":2,"statsText":"Dormant 0/5 - Crack 3 -> Cracked 3/7 - Fold 4","rules":"At the end of your round, if Seed of the Deep is Dormant and took no damage this round, deal 1 damage to it. Cracked - The first time each round it gains Pressure, restore 1 HP to it after that Pressure resolves.","faction":"Living Geodes","code":"GEO","str":0,"hp":5,"crack":3,"crackedStr":3,"crackedHp":7,"fold":4,"legendary":false},{"id":"GEO-022","name":"Faultborn Sentinel","type":"Creature","cost":4,"resource":2,"statsText":"Dormant 2/6 - Crack 2 -> Cracked 5/7 - Fold 4","rules":"On play, deal 1 damage to Faultborn Sentinel and 1 damage to another friendly Geode. Cracked - The first time each round another friendly Geode would take damage, you may redirect 1 of that damage to Faultborn Sentinel.","faction":"Living Geodes","code":"GEO","str":2,"hp":6,"crack":2,"crackedStr":5,"crackedHp":7,"fold":4,"legendary":false},{"id":"GEO-023","name":"Crystal Parasite","type":"Creature","cost":3,"resource":1,"statsText":"Dormant 1/4 - Crack 2 -> Cracked 4/5 - Fold 2","rules":"The first time each round another friendly Geode gains Pressure, deal 1 damage to Crystal Parasite.","faction":"Living Geodes","code":"GEO","str":1,"hp":4,"crack":2,"crackedStr":4,"crackedHp":5,"fold":2,"legendary":false},{"id":"GEO-024","name":"Glassjaw Colossus","type":"Creature","cost":6,"resource":1,"statsText":"Dormant 5/5 - Crack 2 -> Cracked 9/6 - Fold 2","rules":"Whenever one source deals 3 or more damage to Glassjaw Colossus, after its Pressure resolves it gains +2 STR this round.","faction":"Living Geodes","code":"GEO","str":5,"hp":5,"crack":2,"crackedStr":9,"crackedHp":6,"fold":2,"legendary":false},{"id":"GEO-025","name":"Prismatic Broodmother","type":"Creature","cost":7,"resource":1,"statsText":"Dormant 3/8 - Crack 3 -> Cracked 6/9 - Fold 4","rules":"Crack - Summon a Shardling: Dormant 0/3 - Crack 1 -> Cracked 3/3 - Fold 2.","faction":"Living Geodes","code":"GEO","str":3,"hp":8,"crack":3,"crackedStr":6,"crackedHp":9,"fold":4,"legendary":false},{"id":"GEO-026","name":"Aurex, Worldheart Unsealed","type":"Legendary Creature","cost":9,"resource":2,"statsText":"Dormant 4/11 - Crack 4 -> Cracked 10/11 - Fold 5","rules":"On play, deal 1 damage to every friendly Geode, including Aurex. Whenever another friendly Geode Cracks or Folds, restore 1 HP to Aurex. KIMBERLITE - Mantle Detonation: the first Kimberlite pulse each round gives 2 Pressure instead of 1. FRACTURE - Fault Network: the first Fracture trigger each round gives 1 Pressure to two different random friendly Geodes instead of one, if possible.","faction":"Living Geodes","code":"GEO","str":4,"hp":11,"crack":4,"crackedStr":10,"crackedHp":11,"fold":5,"legendary":true},{"id":"GEO-027","name":"Seismic Pulse","type":"Spell","cost":3,"resource":2,"statsText":"-","rules":"Deal 1 damage to every friendly Geode.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-028","name":"Resonance Stress","type":"Spell","cost":4,"resource":2,"statsText":"-","rules":"Choose up to three friendly Geodes. Deal 1 damage to each. Each chosen Geode that is Cracked after its damage resolves gains +2 STR this round.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-029","name":"Crystal Cascade","type":"Spell","cost":5,"resource":1,"statsText":"-","rules":"Until end of round, whenever a friendly Geode Cracks, restore 1 HP to every other friendly Geode.","faction":"Living Geodes","code":"GEO"},{"id":"GEO-030","name":"Premature Detonation","type":"Trap","cost":4,"resource":1,"statsText":"-","rules":"When an enemy creature attacks a friendly Dormant Geode with at least 1 Pressure, deal 1 damage to the defender before combat. If it Cracks, the attacker gets -3 STR for that combat.","faction":"Living Geodes","code":"GEO"}],"Harvest":[{"id":"HAR-001","name":"Furrow Keeper","type":"Creature","cost":3,"resource":2,"statsText":"1/4","rules":"At the end of your round before Wither, another friendly Harvest creature gains +1 maximum and current HP permanently.","faction":"Harvest","code":"HAR","str":1,"hp":4,"legendary":false},{"id":"HAR-002","name":"Briarback","type":"Creature","cost":4,"resource":2,"statsText":"3/5","rules":"The first time each round Briarback survives creature combat damage, it gains +1 maximum and current HP permanently.","faction":"Harvest","code":"HAR","str":3,"hp":5,"legendary":false},{"id":"HAR-003","name":"Hollow Grazer",