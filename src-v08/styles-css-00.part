:root {
  color-scheme: dark;
  --bg: #0a0c10;
  --panel: #10141b;
  --panel-2: #151b24;
  --line: #2a3340;
  --text: #eef2f6;
  --muted: #95a0ae;
  --gold: #d8b76b;
  --danger: #d05c62;
  --good: #70b38f;
  --geo: #3d7c88;
  --continuum: #76589a;
  --harvest: #648451;
  --moon: #984d56;
  --elite: #92743b;
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: radial-gradient(circle at 50% -10%, #1a2230, transparent 38%), var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
button, select, input { font: inherit; }
button { color: inherit; }
body { min-width: 320px; }
.app-shell { width: min(1500px, 100%); margin: 0 auto; padding: 14px; }
.topbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:10px; }
.topbar h1 { margin:0; font-family: Georgia, serif; letter-spacing:.22em; font-size:clamp(24px,4vw,38px); }
.eyebrow { text-transform:uppercase; letter-spacing:.16em; color:var(--muted); font-size:11px; font-weight:800; }
.top-actions { display:flex; gap:8px; flex-wrap:wrap; }
.btn, .icon-btn { border:1px solid var(--line); background:#171d26; border-radius:10px; padding:10px 14px; cursor:pointer; font-weight:800; }
.btn:hover, .icon-btn:hover { border-color:#596679; }
.btn.primary { background:linear-gradient(180deg,#7c6640,#5d492b); border-color:#a1834d; }
.btn.good { background:#26493a; border-color:#4d846d; }
.btn.danger { background:#4c272c; border-color:#8e444d; }
.btn.ghost { background:transparent; }
.btn.small { padding:7px 9px; font-size:12px; }
.btn.large { width:100%; padding:14px 16px; font-size:16px; }
.btn:disabled { opacity:.4; cursor:not-allowed; }
.game-root { display:grid; gap:10px; }
.realm-banner { border:1px solid var(--line); background:linear-gradient(90deg,#11161d,#171d25,#11161d); border-radius:16px; padding:11px 14px; display:flex; gap:16px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
.realm-banner strong { font-family:Georgia,serif; font-size:18px; }
.realm-effects { color:var(--muted); font-size:12px; max-width:900px; }
.phase-strip { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
.pill { border:1px solid var(--line); border-radius:999px; padding:6px 10px; font-size:12px; background:#111720; }
.pill.active { border-color:var(--gold); color:#ffe3a0; }
.player-zone { border:1px solid var(--line); border-radius:18px; background:linear-gradient(180deg,#11161d,#0d1117); overflow:hidden; }
.player-zone.active { outline:2px solid rgba(216,183,107,.55); outline-offset:1px; }
.player-zone.ai { opacity:.96; }
.player-header { padding:10px 12px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
.player-id { display:flex; align-items:center; gap:10px; min-width:0; }
.faction-dot { width:12px; height:12px; border-radius:50%; flex:0 0 auto; }
.player-name { font-weight:900; }
.player-sub { color:var(--muted); font-size:12px; }
.statbar { display:flex; gap:7px; flex-wrap:wrap; }
.stat { border:1px solid var(--line); background:#0d1219; border-radius:10px; padding:6px 9px; font-size:12px; }
.stat b { font-size:14px; }
.board-wrap { padding:10px; }
.zone-label { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.14em; margin-bottom:6px; display:flex; justify-content:space-between; gap:8px; }
.board-grid { display:grid; grid-template-columns:repeat(7,minmax(110px,1fr)); gap:7px; overflow-x:auto; padding-bottom:4px; }
.slot { min-height:154px; border:1px dashed #364151; border-radius:12px; padding:5px; background:rgba(255,255,255,.012); min-width:110px; }
.slot.empty::after { content:"OPEN"; display:grid; place-items:center; height:100%; min-height:142px; color:#465261; font-size:10px; letter-spacing:.2em; }
.trap-row { display:flex; gap:7px; overflow-x:auto; min-height:58px; }
.trap-chip { border:1px solid var(--line); background:#141923; padding:8px 10px; border-radius:10px; min-width:135px; cursor:pointer; font-size:11px; }
.trap-chip.hidden { color:#8f99a5; background:repeating-linear-gradient(135deg,#111821,#111821 8px,#151e29 8px,#151e29 16px); }
.hand-wrap { border-top:1px solid var(--line); padding:9px 10px 11px; }
.hand { display:flex; gap:8px; overflow-x:auto; padding:2px 1px 8px; min-height:178px; }
.hand.hidden-hand { align-items:center; min-height:72px; }
.card-back { width:108px; height:58px; border:1px solid #394556; border-radius:10px; display:grid; place-items:center; background:repeating-linear-gradient(45deg,#141b25,#141b25 8px,#1a2330 8px,#1a2330 16px); color:#798798; font-weight:900; letter-spacing:.15em; }
.card { width:145px; min-width:145px; height:168px; border-radius:12px; border:1px solid #465264; background:linear-gradient(180deg,#1a202a,#10151c); display:flex; flex-direction:column; overflow:hidden; cursor:pointer; position:relative; transition:transform .12s ease,border-color .12s ease; }
.card:hover { transform:translateY(-2px); border-color:#79879a; }
.card.selected { outline:2px solid var(--gold); }
.card.acted { opacity:.55; }
.card.legendary { border-color:#b79552; box-shadow:inset 0 0 0 1px rgba(216,183,107,.22); }
.card.geo { --fc:var(--geo); }
.card.continuum { --fc:var(--continuum); }
.card.harvest { --fc:var(--harvest); }
.card.moondemons { --fc:var(--moon); }
.card.eliteborn { --fc:var(--elite); }
.card-head { padding:7px 8px 6px; background:linear-gradient(90deg,var(--fc,#45566c),rgba(20,24,31,.9)); border-bottom:1px solid rgba(255,255,255,.08); }
.card-name { font-weight:900; font-size:11px; line-height:1.15; min-height:25px; }
.card-meta { display:flex; justify-content:space-between; gap:6px; font-size:10px; margin-top:4px; color:#dfe6ed; }
.card-body { padding:7px 8px; display:flex; flex-direction:column; gap:5px; min-height:0; flex:1; }
.card-rules { font-size:9px; line-height:1.25; color:#c0c9d2; overflow:hidden; display:-webkit-box; -